{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codr",
  "version": "1.0.0",
  "identifier": "io.github.kevsmir02.codr",
  "build": {
    "beforeDevCommand": "pnpm build:cli:dev && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:cli && pnpm build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "Codr",
        "width": 800,
        "height": 600,
        "minWidth": 420,
        "minHeight": 280,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https://asset.localhost blob: https: http://localhost:* http://127.0.0.1:*; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: http://127.0.0.1:* http://localhost:*; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost terax-pty: http://terax-pty.localhost https: http://localhost:* http://127.0.0.1:*; frame-src 'self' http: https: asset: http://asset.localhost https://asset.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/codr-cli"
    ],
    "resources": {
      "../packages/ghostty-core/LICENSE": "licenses/terminal/ghostty-web.txt",
      "../packages/ghostty-core/adapted/LICENSE.ghostty": "licenses/terminal/ghostty.txt",
      "../packages/ghostty-core/adapted/LICENSE.restty": "licenses/terminal/restty.txt",
      "../src/modules/terminal/ghostty/webgl/LICENSE.xterm-js": "licenses/terminal/xterm-js.txt"
    },
    "targets": [
      "rpm",
      "deb"
    ],
    "createUpdaterArtifacts": false,
    "copyright": "Copyright 2026 Crynta and Codr contributors",
    "license": "Apache-2.0",
    "publisher": "kevsmir02",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "Codr - Linux terminal workspace with editor, Git and previews",
    "longDescription": "Codr is an unofficial fork of Terax for Linux x86-64: multi-tab terminal, file explorer, code editor, source control and rendered previews, built by kevsmir02 and not affiliated with Crynta.",
    "fileAssociations": [
      {
        "name": "Codr Document",
        "role": "Editor",
        "mimeType": "text/plain",
        "ext": [
          "json", "jsonc", "txt", "log", "csv", "tsv",
          "md", "markdown", "mdx",
          "js", "mjs", "cjs", "jsx", "ts", "tsx", "mts", "cts",
          "java", "kt", "kts", "gradle",
          "py", "rb", "php", "go", "rs", "swift", "dart", "lua",
          "c", "h", "cpp", "cc", "hpp", "hh", "cs",
          "html", "htm", "css", "scss", "sass", "less", "vue", "svelte",
          "xml", "yaml", "yml", "toml", "ini", "cfg", "conf", "properties",
          "sh", "bash", "zsh", "sql", "graphql", "proto"
        ]
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0MDk3Qjc1REI0OThCMjEKUldRaGkwbmJkWHNKbEZ1OWI0OHNtallkdFpLelozQW42cmpoS1J6K2tkTDB0RzhmN0RCSmo4bEwK",
      "endpoints": [
        "https://github.com/kevsmir02/terax-ai/releases/latest/download/latest.json"
      ]
    }
  }
}
